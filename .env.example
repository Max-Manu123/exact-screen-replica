# Copy to .env and fill in the values for your own environment.
# Never commit real values. Only variable names belong in this file.

# Lovable Cloud (backend) — publishable, safe for the browser
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# PostHog — project token is publishable, safe for the browser
VITE_LOVABLE_CONNECTOR_POSTHOG_API_KEY=
VITE_LOVABLE_CONNECTOR_POSTHOG_REGION=
VITE_LOVABLE_CONNECTOR_POSTHOG_PROJECT_ID=

# Server-only (never expose to the browser)
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_REGION=
